BOT_QQ=YOUR_BOT_QQ
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# NapCat 必须使用与其匹配的项目专用 QQ，不能指向桌面自动更新版 QQ。
QQ_EXE=C:\Path\To\NapCat.Shell\QQ.exe
NAPCAT_DIR=C:\Path\To\NapCat.Shell\versions\QQ_VERSION\resources\app\napcat
# 专用 Electron 配置目录；不得设为 %APPDATA%\QQ。
QQ_PROFILE_DIR=<your-atrai-project>\data\runtime\qq-profile

# private: only reply to private messages
# mention: private messages + group messages that mention the bot or "亚托莉"
# smart: private messages + owner/group direct triggers; avoids replying to every group message
# all: reply to all messages (not recommended)
REPLY_MODE=smart

# Default: local Ollama OpenAI-compatible chat API.
# Leave OPENAI_API_KEY empty to use local fallback replies only.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3:4b-instruct
OLLAMA_MODELS=%LOCALAPPDATA%\Ollama\models
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32
OLLAMA_KEEP_ALIVE=0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Controls the reply style when an API key is configured.
TEMPERATURE=0.60
FREQUENCY_PENALTY=0.35
MAX_TOKENS=180
CHAT_REQUEST_TIMEOUT_SECONDS=25
CHAT_RESOURCE_WAIT_SECONDS=35
CHAT_QUALITY_RETRIES=1

# Send replies as several short QQ messages, like streaming.
MESSAGE_SPLIT_MAX_CHARS=44
MESSAGE_SPLIT_MAX_PARTS=4
MESSAGE_SEND_DELAY_MIN=0.55
MESSAGE_SEND_DELAY_MAX=1.35

# Local stickers. Put images under data/stickers/<emotion>/.
STICKER_DIR=data/stickers
STICKER_TRIGGER_FILE=data/stickers/triggers.json
STICKER_CHANCE=0.32
STICKER_COOLDOWN_SECONDS=120
STICKER_CAPTURE_ENABLED=true
STICKER_CAPTURE_MAX_BYTES=3000000
# Incoming sticker archive; defaults to Documents/Tencent Files/<BOT_QQ>/ATRI/chat_history.
# STICKER_CAPTURE_DIR=%USERPROFILE%/Documents/Tencent Files/YOUR_BOT_QQ/ATRI/chat_history
# QQ_RECORDS_ROOT=%USERPROFILE%/Documents/Tencent Files

# User habit memory and light idle care.
MEMORY_PATH=data/memory/users.json
# JSON 仍是唯一可编辑事实源。SQLite+FTS5 只是可重建索引，默认不加载 bge-m3。
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_RETRIEVAL_PATH=data/memory/semantic_memory.sqlite3
MEMORY_RETRIEVAL_MAX_CHARS=1800
MEMORY_RETRIEVAL_LORE_LIMIT=3
MEMORY_RETRIEVAL_MEMORY_LIMIT=5
MEMORY_VECTOR_ENABLED=false
MEMORY_EMBEDDING_MODEL=bge-m3:latest
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEMORY_EMBEDDING_TIMEOUT_SECONDS=2
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_LLM_ENABLED=true
MEMORY_EXTRACTION_MODEL=deepseek-v4-flash
MEMORY_EXTRACTION_BASE_URL=https://api.deepseek.com/v1
MEMORY_EXTRACTION_TIMEOUT_SECONDS=10
MEMORY_EXTRACTION_COOLDOWN_SECONDS=45
MEMORY_BACKFILL_ENABLED=true
MEMORY_BACKFILL_MAX_CONVERSATIONS=250
# LivingMemory episodic memory: batch conversations -> LLM summary -> hybrid retrieval (BM25 + optional vectors).
# Independent of users.json and semantic_memory.sqlite3; stores data/memory/living_memory.sqlite3.
LIVING_MEMORY_ENABLED=true
LIVING_MEMORY_TRIGGER_MESSAGES=16
LIVING_MEMORY_MAX_BATCH_MESSAGES=40
LIVING_MEMORY_TOP_K=4
LIVING_MEMORY_MIN_IMPORTANCE=0.25
LIVING_MEMORY_RECENT_COUNT=1
LIVING_MEMORY_RECENT_MAX_AGE_HOURS=72
LIVING_MEMORY_EMBEDDING_ENABLED=true
LIVING_MEMORY_LLM_TIMEOUT_SECONDS=60
LIVING_MEMORY_MAINTENANCE_INTERVAL_HOURS=6
LIVING_MEMORY_FORGET_DELAY_DAYS=7
LIVING_MEMORY_PURGE_DELAY_DAYS=30
# Topic backfill after long group silence (disconnects / overnight).
GAP_BACKFILL_ENABLED=true
GAP_BACKFILL_THRESHOLD_SECONDS=7200
GAP_BACKFILL_LOOKBACK_SECONDS=21600

# ── Suwayomi 漫画助手（移植自 astrbot_plugin_suwayomi_server）──────────
# 需要本机运行 Suwayomi-Server（默认 http://127.0.0.1:4567），并在其 WebUI
# 安装漫画源扩展。订阅数据保存在 data/manga/store.json。
# auth 可选 none/basic；basic 时填写 Suwayomi 的用户名密码。
MANGA_ENABLED=true
MANGA_SERVER_URL=http://127.0.0.1:4567
MANGA_AUTH_MODE=none
MANGA_USERNAME=
MANGA_PASSWORD=
# 阅读模式单次发送的最大页数。
MANGA_MAX_PAGES=20
# 下载打包默认格式：pdf/zip/cbz；img2pdf 未安装时 PDF 自动降级 ZIP。
MANGA_DOWNLOAD_FORMAT=pdf
MANGA_DOWNLOAD_CONCURRENCY=6
MANGA_DOWNLOAD_RETRIES=3
# 更新检查间隔（分钟，最小 5）。
MANGA_CHECK_INTERVAL_MINUTES=60
# 章节列表缓存小时数；-1 表示总是强制刷新，0 表示只读服务器缓存。
MANGA_CHAPTER_CACHE_HOURS=6
# 默认搜索源 ID；0 表示自动选择。
MANGA_DEFAULT_SOURCE_ID=0
# 聊天模型的漫画工具（suwayomi_*）与主动发送章节权限。
MANGA_AI_TOOLS_ENABLED=true
MANGA_ALLOW_AI_SEND=true
MANGA_AI_MAX_SOURCES=5
MANGA_AI_RESULTS_PER_SOURCE=5
MANGA_AI_TOOL_TIMEOUT_SECONDS=60
# 自动推送内容形式：image=逐页图片，file=打包文件。
MANGA_AUTO_PUSH_MODE=image
# 章节图片临时目录；留空使用系统临时目录。
MANGA_TEMP_DIR=

# ── Anima 绘画助手（移植自 astrbot_plugin_anima_master）──────────────
# 自然语言画图：聊天模型识别绘画意图后调用 anima_draw 工具，自动整理
# Danbooru 标签并交给本机 ComfyUI（默认 http://127.0.0.1:8188）出图。
# 首次启动会从 AstrBot 侧导入一次插件配置，之后独立管理
# data/anima/config.json。ComfyUI 部署完成前保持关闭。
ANIMA_ENABLED=false
# 提示词优化 LLM；留空复用上方 OPENAI_* 配置。
ANIMA_PROMPT_MODEL=
ANIMA_PROMPT_BASE_URL=
ANIMA_PROMPT_API_KEY=
ANIMA_PROMPT_TIMEOUT_SECONDS=90
# anima_draw 工具整体执行预算（含出图排队）。
ANIMA_TOOL_TIMEOUT_SECONDS=420

# ── MiniMax 绘图（draw_image 工具）─────────────────────────────────
# 自然语言画图：聊天模型识别绘画意图后调用 draw_image 工具，调用
# MiniMax image-01 / image-01-live 云端文生图，无需本地 GPU。
# 国内站默认 https://api.minimax.cn，海外填 https://api.minimaxi.com。
MINIMAX_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_TIMEOUT_SECONDS=120
# 画图前 LLM 精炼提示词（扩写细节 + 人物外貌联网检索），失败自动退回原始描述。
MINIMAX_PROMPT_REFINE=true

# ── B站视频解析与 AI 总结 ──────────────────────────────────────────
# 移植自 AstrBot biliVideo 插件。命令：B站总结 <链接/BV号>、B站解析
# <链接/BV号>、B站帮助。优先使用平台字幕；无字幕视频下载音频走必剪
# ASR 转写（较慢）。总结按 BV 号缓存 6 小时。LLM 复用上方 OPENAI_* 配置。
BILIBILI_ENABLED=true
# 群里发送纯 B站链接/分享卡片时自动生成总结（另有按会话 180 秒冷却）。
BILIBILI_AUTO_SUMMARY=false
# 总结风格：concise（简洁）/ detailed（详细）/ professional（专业）。
BILIBILI_NOTE_STYLE=professional
# 可选：浏览器登录后的 Cookie（SESSDATA=xxx; buvid3=xxx），提高部分
# 视频的字幕可见性；留空匿名访问。
BILIBILI_COOKIE=
# 无字幕视频是否下载音频并转写（必剪 ASR）。
BILIBILI_ASR_ENABLED=true
# 命令冷却秒数（按用户）。
BILIBILI_COOLDOWN_SECONDS=20
# 单条总结最大字符数，超出智能截断。
BILIBILI_MAX_NOTE_LENGTH=3500
# 单次命令整体处理超时秒数。
BILIBILI_TIMEOUT_SECONDS=300
# 音频临时目录；留空使用 data/bilibili/audio。
BILIBILI_AUDIO_DIR=
# bilibili_read LLM 工具（BiliRead 移植）：模型可主动读取视频字幕/转写
# 素材，用人设口吻聊视频内容；关闭后仅保留「B站总结」命令。
BILIBILI_AI_TOOL_ENABLED=true
# 工具单次执行超时秒数（无字幕视频转写音频可能需要 1-3 分钟）。
BILIBILI_AI_TOOL_TIMEOUT_SECONDS=150
# 交回对话模型的字幕素材最大字符数，超出截断。
BILIBILI_AI_TOOL_MAX_CHARS=4000

# ── 启动期依赖服务引导 ─────────────────────────────────────────────
# ATRI 启动时自动拉起插件所需的本机服务：Suwayomi-Server（执行启动脚本并
# 等待就绪）与 NapCat/QQNT（复用 hidden_launcher napcat 分片，自带扫码
# 登录状态机）。引导失败只记录警告，不阻塞 bot 启动。
BOOTSTRAP_SERVICES_ENABLED=true
BOOTSTRAP_SUWAYOMI_ENABLED=true
# Suwayomi 启动脚本路径（脚本自带"已在运行"检测）。
BOOTSTRAP_SUWAYOMI_SCRIPT=C:\AI-girlfriend-QQ-main\Suwayomi\start-suwayomi.ps1
# Suwayomi 启动后就绪等待秒数（JVM 冷启动较慢）。
BOOTSTRAP_SUWAYOMI_TIMEOUT_SECONDS=120
BOOTSTRAP_NAPCAT_ENABLED=true
MANGA_AUTO_PUSH_MODE=image
# 章节图片临时目录；留空使用系统临时目录。
MANGA_TEMP_DIR=
OWNER_QQ=
# New context-aware private proactive scheduler. Set false to immediately use the legacy idle/morning loops.
PROACTIVE_V2_ENABLED=false
IDLE_PROACTIVE_ENABLED=true
IDLE_MINUTES=120
IDLE_COOLDOWN_MINUTES=480
IDLE_CHECK_SECONDS=60

# Group chat context and low-frequency cold-room nudges.
# Hard cap is 3 proactive messages per group per day.
GROUP_CONTEXT_ENABLED=true
GROUP_PROACTIVE_ENABLED=true
GROUP_PROACTIVE_IDLE_MINUTES=60
GROUP_PROACTIVE_COOLDOWN_MINUTES=180
GROUP_PROACTIVE_DAILY_LIMIT=3
GROUP_PROACTIVE_CHECK_SECONDS=90

# Daily morning greeting. If OWNER_QQ is empty, it sends to private users who have chatted with her.
MORNING_GREETING_ENABLED=true
MORNING_GREETING_TIME=07:30
MORNING_GREETING_TIMEZONE=Asia/Shanghai
MORNING_GREETING_CATCHUP_MINUTES=90

# Nightly goodnight greeting: send image + text to all joined groups at the scheduled time.
GOODNIGHT_ENABLED=true
GOODNIGHT_TIME=23:30
GOODNIGHT_TIMEZONE=Asia/Shanghai
GOODNIGHT_CATCHUP_MINUTES=30
# GOODNIGHT_IMAGE=data/assets/goodnight.jpg
# GOODNIGHT_STATE_PATH=data/runtime/goodnight-state.json

# Material toolbox: documents, tables, webpages, images, and direct video files.
# 视觉识别默认走 DeepSeek V4.1 Flash 多模态（deepseek-flash，原生识图）；
# 也可换回本地 Ollama（qwen3-vl:8b-instruct @ http://127.0.0.1:11434/v1）。
TOOLBOX_ENABLED=true
TOOLBOX_TIMEOUT_SECONDS=18
TOOLBOX_MAX_BYTES=2000000
TOOLBOX_MAX_DOCUMENT_BYTES=20000000
TOOLBOX_MAX_MEDIA_BYTES=80000000
TOOLBOX_VISION_ENABLED=true
TOOLBOX_VISION_MODEL=deepseek-flash
TOOLBOX_VISION_FALLBACK_MODEL=
TOOLBOX_VISION_BASE_URL=https://api.deepseek.com/v1
TOOLBOX_VISION_API_KEY=YOUR_DEEPSEEK_API_KEY
TOOLBOX_VISION_MAX_BYTES=8000000
TOOLBOX_VISION_RETRY_COUNT=0
TOOLBOX_VISION_RESOURCE_WAIT_SECONDS=10
TOOLBOX_VISION_TIMEOUT_SECONDS=55
TOOLBOX_VISION_UNLOAD_OTHER_OLLAMA_MODELS=false
TOOLBOX_OCR_ENABLED=true
# AnimeTrace 二次元角色库人脸匹配（api.animetrace.com，免密钥公开服务）。
# 命中人脸框直接参与身份裁决，与 trace.moe（动画原帧/集数）互补；
# 对同人图/裁剪脸/头像这类非原帧图尤其有效。false=彻底停用该途径。
ANIMETRACE_ENABLED=true
TOOLBOX_VIDEO_FRAME_ANALYSIS_ENABLED=true
TOOLBOX_VIDEO_MAX_FRAMES=4
TOOLBOX_VIDEO_DEADLINE_SECONDS=60

# LLM Agent tool loop: every turn chooses a real tool action or final_answer.
# LLM_TOOL_MAX_CALLS：每轮回复的工具调用总预算（1-4）。
# 漫画链路需要 search -> get_chapters -> send_chapter 三连，预算 2 会导致
# 预算耗尽后 tools 被移除、模型只能嘴上说"我去拿"却发不出章节。
LLM_TOOLS_ENABLED=true
LLM_TOOL_MAX_CALLS=4
LLM_AGENT_PROTOCOL_ENABLED=false
LLM_AGENT_MAX_STEPS=6
LLM_AGENT_MAX_TOOL_CALLS=3
HUMAN_REPLY_PIPELINE_ENABLED=true

# 持续认知内核。影子模式只维护目标、思维承接、情绪和自我经历，
# 不会替代当前回复、发送 QQ 消息或执行副作用工具。
COGNITION_SHADOW_ENABLED=true
COGNITION_STATE_PATH=data/cognition/state.sqlite3
COGNITION_SHADOW_TIMEOUT_SECONDS=2
COGNITION_SHADOW_MAX_CONCURRENCY=2
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=6
WEB_SEARCH_MAX_RESULTS=5
WEB_PAGE_MAX_CHARS=8000
WEB_GROUNDING_REVIEW_ENABLED=true

# QQ 空间动态管理。依赖本机 onebot-qzone Bridge；默认关闭。
# Cookie 只配置在 Bridge 中，不要写入本项目 .env。
QZONE_BRIDGE_ENABLED=false
QZONE_BRIDGE_URL=http://127.0.0.1:5700
QZONE_BRIDGE_TOKEN=
QZONE_BRIDGE_TIMEOUT_SECONDS=8
QZONE_AUTOMATION_DB=data/qzone_automation.sqlite3

# 歌声工程参考音源目录（WebUI 歌曲合成页扫描；Seed-VC 转换由 AI_music 桥接负责）。
ATRI_ORIGINAL_VOICE_LIBRARY=C:\Users\YOUR_NAME\Music\ATRI训练音频素材

# 回复质量评测与群聊总结（独立旁路）。数据库只保存在本机。
INSIGHTS_DB_PATH=data/insights/insights.sqlite3
EVALUATION_ENABLED=true
# 系统程序自动评测 ATRI 实际回复。
SYSTEM_EVALUATION_ENABLED=true
# 直接复用“模型”页面当前激活的聊天模型作为评测器。
EVALUATION_USE_CHAT_MODEL=true
# 留空跟随当前聊天模型；填写“模型”页面中某个聊天档案 id 可单独指定评测模型。
EVALUATION_MODEL_PROFILE_ID=
# 评测默认直接复用“模型”页面当前激活的聊天模型；以下三项仅在
# EVALUATION_USE_CHAT_MODEL=false 时作为旧版独立 Judge 配置使用。
EVALUATION_BASE_URL=https://api.deepseek.com/v1
EVALUATION_API_KEY=
EVALUATION_MODEL=deepseek-chat
EVALUATION_TIMEOUT_SECONDS=45
EVALUATION_WORKERS=1
EVALUATION_QUEUE_SIZE=256
EVALUATION_DIMENSIONS=relevancy,accuracy,completeness,coherence,faithfulness,hallucination
EVALUATION_SEMANTIC_ENABLED=true
EVALUATION_SEMANTIC_WEIGHT=0.15
INSIGHTS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# true 时只使用已下载到本机缓存的向量模型，不联网下载。
INSIGHTS_EMBEDDING_LOCAL_ONLY=false

# 群消息归档默认开启；仅写入本机 SQLite，不改变 QQ 回复策略。
GROUP_CHAT_ARCHIVE_ENABLED=true
GROUP_SUMMARY_ENABLED=true
# 旧版全局定时字段仅为兼容旧配置保留；新的自动总结计划请在 WebUI 的“群聊总结”中逐群设置，默认全部关闭。
GROUP_SUMMARY_SCHEDULE_ENABLED=false
GROUP_SUMMARY_SCHEDULE_TIME=00:10
GROUP_SUMMARY_SCHEDULE_PERIOD=daily
# WebUI 计划的日报按最近24小时、周报按最近7天、月报按当前自然月生成。
GROUP_SUMMARY_LOOKBACK_HOURS=24
GROUP_SUMMARY_MIN_MESSAGES=20
# 旧版群号筛选字段仅保留兼容；逐群计划不再使用它。
GROUP_SUMMARY_GROUP_IDS=
GROUP_SUMMARY_MAX_MESSAGES=3000
GROUP_SUMMARY_CLUSTER_THRESHOLD=0.52
GROUP_SUMMARY_MAX_TOPICS=8

# 事实核查（是真的吗）：fact_check 工具，LLM 规划 + Bocha 搜索取证 + 三态裁决
ISITTRUE_ENABLED=false

# 学术论文检索：search_papers 工具（OpenAlex 免 key 全学科文献库）
PAPERS_ENABLED=true
PAPERS_TIMEOUT_SECONDS=30

# ── 舞萌 DX 查分器（search_maimai_best50 工具）─────────────────────
# 移植自 AstrBot astrbot_plugin_maimaidx（落雪开发者模式）。管理员在落雪
# 查分器 https://maimai.lxns.net 「开发者」页面申请 Token 填入下方；
# 玩家需在落雪官网绑定 QQ 号，并在账号设置-隐私设置中允许第三方读取成绩。
# 配好后自然语言即可查分：「查一下我的 b50」「我舞萌 rating 多少」。
# 未填 Token 时工具不注册，不影响其他功能。
MAIMAI_ENABLED=true
MAIMAI_LXNS_DEV_TOKEN=
MAIMAI_TIMEOUT_SECONDS=20

# 屏幕看护：主人指令截屏问答；持续监控入库默认关（开屏高频会占用视觉模型）
SCREEN_WATCH_ENABLED=true
SCREEN_WATCH_MONITOR_ENABLED=false
SCREEN_WATCH_INTERVAL_SECONDS=1
SCREEN_WATCH_DIFF_THRESHOLD=8
SCREEN_WATCH_COOLDOWN_SECONDS=120
SCREEN_WATCH_BACKOFF_MAX_SECONDS=300

# 屏幕看护围观模式：「看着我 xx」持续看屏插短评
SCREEN_WATCH_PARTY_ENABLED=true
SCREEN_WATCH_PARTY_MIN_INTERVAL_SECONDS=180
SCREEN_WATCH_PARTY_SAMPLE_SECONDS=10
SCREEN_WATCH_PARTY_MAX_FAILURES=5
SCREEN_WATCH_PARTY_ANNOUNCE_COOLDOWN_SECONDS=600
